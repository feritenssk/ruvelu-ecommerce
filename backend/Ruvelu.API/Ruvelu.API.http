@Ruvelu.API_HostAddress = http://localhost:5297

GET {{Ruvelu.API_HostAddress}}/api/products
Accept: application/json
###
POST {{Ruvelu.API_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Zümrüt Kolye",
  "description": "El yapımı zümrüt taşlı kolye",
  "price": 1500,
  "stock": 5,
  "imageUrl": "https://example.com/kolye.jpg"
}

###
PUT {{Ruvelu.API_HostAddress}}/api/products/1
Content-Type: application/json

{
  "name": "Zümrüt Kolye - Güncellendi",
  "description": "El yapımı zümrüt taşlı kolye, yeni fiyat",
  "price": 1800,
  "stock": 3,
  "imageUrl": "https://example.com/kolye-v2.jpg"
}
###
DELETE {{Ruvelu.API_HostAddress}}/api/products/2